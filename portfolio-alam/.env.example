# Salin file ini menjadi `.env` lalu isi nilainya.
# PENTING: semua variabel berawalan VITE_ terekspos ke bundle publik.
# JANGAN pernah menaruh API key, token, atau secret di sini.

# Endpoint pengiriman form kontak (harus https).
# Catatan CSP: jika endpoint berbeda domain, tambahkan host-nya ke
# `connect-src` pada vercel.json / public/_headers.
# Kosongkan jika belum ada — form akan berjalan dalam "mode demo".
VITE_CONTACT_ENDPOINT=
