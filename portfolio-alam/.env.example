# Salin file ini menjadi `.env` lalu isi nilainya.
# PENTING: semua variabel berawalan VITE_ terekspos ke bundle publik.
# JANGAN pernah menaruh API key, token, atau secret di sini.

# Endpoint pengiriman form kontak (opsional; default memakai /api/contact di Vercel).
VITE_CONTACT_ENDPOINT=

# Environment variable untuk Vercel Serverless Function (/api/contact):
# Isi di Vercel Dashboard -> Settings -> Environment Variables (JANGAN taruh key asli di git).
RESEND_API_KEY=
CONTACT_TO_EMAIL=randy021104@gmail.com
RESEND_FROM_EMAIL=Portofolio <onboarding@resend.dev>
